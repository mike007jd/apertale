{
  "name": "apertale",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/sync-site-manifest.mjs && vite",
    "typecheck": "tsc --noEmit",
    "tokens": "node scripts/generate-tokens.mjs",
    "tokens:check": "node scripts/generate-tokens.mjs --check && node scripts/check-tokens.mjs",
    "test": "vitest run",
    "catalog:assets": "node scripts/sync-bundled-asset-catalog.mjs --write",
    "build": "node scripts/sync-site-manifest.mjs && node scripts/sync-bundled-asset-catalog.mjs && vite build && node scripts/prepare-sites-build.mjs && node scripts/sync-sites-migrations.mjs",
    "preview": "vite preview",
    "test:sites": "npm run build && npm run test:sites:built",
    "test:sites:built": "node --test tests/*.test.mjs",
    "optimize:assets": "node scripts/optimize-runtime-images.mjs --write",
    "audit:cutouts": "node scripts/audit-cutout-alpha.mjs",
    "verify:release": "npm run tokens:check && npm run typecheck && npm test && npm run test:sites && npm run audit:cutouts",
    "verify:deployment": "node scripts/verify-deployment.mjs"
  },
  "dependencies": {
    "@phosphor-icons/react": "2.1.10",
    "@vitejs/plugin-react": "5.0.4",
    "motion": "13.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.185.1",
    "vite": "6.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/three": "0.185.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "webmcp-types": "0.1.5"
  }
}
