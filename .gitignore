# macOS and editor state
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Local credentials and machine-specific configuration
.env
.env.*
!.env.example
*.local

# Dependencies, caches, and generated builds
node_modules/
dist/
.vite/
coverage/
.cache/
*.tsbuildinfo

# Local code-intelligence index
/.gitnexus/

# Local browser and test-run artifacts
**/test-results/
**/playwright-report/
**/blob-report/

# Local agent and browser verification state
# Keep ephemeral worktrees, browser snapshots, traces, and generated media local.
/.claude/worktrees/
/.playwright-mcp/
/output/

# Local production Live Verify workspaces
# Keep screenshots, generated art, upload fixtures, copied prompts, and browser/WebMCP logs local.
# Durable release evidence belongs in an explicitly curated QA closeout directory instead.
docs/qa/*-live-verify-*/
